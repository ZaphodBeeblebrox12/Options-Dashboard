# Angel One SmartAPI v2 Credentials
# Get these from your Angel One account + TOTP app
API_KEY=your_api_key_here
CLIENT_CODE=your_client_code_here
PASSWORD=your_password_here
TOTP_SECRET=your_totp_secret_here

# Optional absolute path to the shared SQLite database used by the dashboard
# and TradeThesis Charts. On Windows, use forward slashes, for example:
# TRADETHESIS_DB_PATH=C:/Projects/chartinglibrary/nifty_snapshots.db
