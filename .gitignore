# ===========================
# Python / Backend
# ===========================
# Virtual environments (covers .venv, venv, env, etc.)
.venv/
venv/
env/
ENV/
backend/.venv/

# Python cache files (covers root and backend/__pycache__)
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyc
*.pyo
*.pyd

# Databases — live files, journals, AND timestamped backups
# (nifty_snapshots.db.bak-20261002-140334 etc.)
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
*.db.bak-*

# Backend runtime folders
backend/cache/
backend/logs/

# Backend debug artifacts
freeze_dump.txt
backend_liveness.log

# Distribution / packaging
build/
*.egg-info/
.eggs/

# ===========================
# Node.js / Frontend
# ===========================
# Dependencies (covers frontend/node_modules at any depth)
node_modules/

# Build output (covers frontend/dist)
dist/
*.log

# ===========================
# Environment Variables & Secrets
# ===========================
# CRITICAL: .env* (not .env) — covers .env, .env.local,
# .env.production, and numbered variants like .env1
.env*
!*.env.example
!*.env.sample

# ===========================
# Backup & experiment files
# ===========================
# Covers App.tsx.bak, App.tsx.disabled-wallchart, etc.
*.bak
*.bak-*
*.orig
*.disabled-*

# ===========================
# IDEs & OS
# ===========================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
filelist.txt